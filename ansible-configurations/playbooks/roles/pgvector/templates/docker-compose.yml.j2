services:
  db:
    container_name: pgvector-db
    image: pgvector/pgvector:pg{{ pg_vector.version }}
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: "{{ pgvector_password }}"
      POSTGRES_DB: "{{ pg_vector.database }}"
      POSTGRES_USER: postgres
    ports:
      - "127.0.0.1:{{ pg_vector.port }}:5432"
    volumes:
      - {{ pgvector_base_dir }}/data:/var/lib/postgresql/data
      - {{ pgvector_base_dir }}/init:/docker-entrypoint-initdb.d
