// Scrape Node Exporter and tag metrics with this device's hostname
prometheus.scrape "node_exporter" {
  targets = [{
    __address__ = "{{ alloy_docker_host }}:{{ node_exporter_port }}",
    instance    = "{{ grafana_alloy.instance_name | default(ansible_hostname) }}",
    job         = "node_exporter",
  }]
  scrape_interval = "15s"
  forward_to     = [prometheus.relabel.node_exporter_compat.receiver]
}

// ── Scrape cAdvisor (on the monitoring Docker network) ───────────────────
prometheus.scrape "cadvisor" {
  targets = [{
    __address__ = "{{ alloy_docker_host }}:{{ cadvisor_port }}",   // reachable by container name on the network
    instance    = "{{ grafana_alloy.instance_name | default(ansible_hostname) }}",
    job         = "cadvisor",
  }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.platform.receiver]
}


// Push metrics to the central Prometheus instance on the platform
prometheus.remote_write "platform" {
  endpoint {
    url = "{{ grafana_alloy.alloy_remote_write_url | default('https://' ~ prometheus.domain ~ '/api/v1/write') }}"
  }
}

// Rename metrics for dashboard compatibility.
// On macOS, Node Exporter uses different memory metric names than Linux.
// These rules rename them to the Linux names expected by Node Exporter Full (dashboard ID 1860).
prometheus.relabel "node_exporter_compat" {
  forward_to = [prometheus.remote_write.platform.receiver]

{% if ansible_facts['system'] == 'Darwin' %}
  // node_memory_MemTotal_bytes: total physical RAM
  rule {
    source_labels = ["__name__"]
    regex         = "node_memory_total_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_MemTotal_bytes"
  }
  // node_memory_MemAvailable_bytes: approximate — macOS "free" only.
  // Active + wired + inactive pages will appear as "used", which slightly overstates usage.
  rule {
    source_labels = ["__name__"]
    regex         = "node_memory_free_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_MemAvailable_bytes"
  }
  // node_memory_SwapTotal_bytes: rename to Linux name for dashboard compatibility.
  // SwapFree is computed on the Prometheus side via a recording rule (swap_total - swap_used).
  rule {
    source_labels = ["__name__"]
    regex         = "node_memory_swap_total_bytes"
    target_label  = "__name__"
    replacement   = "node_memory_SwapTotal_bytes"
  }
{% endif %}
}

// ── OTLP receiver: accept telemetry from instrumented services ───────────────
// Apps push metrics via OTel SDK using:
//   endpoint = "http://<alloy-host>:4317"  (gRPC)
//   endpoint = "http://<alloy-host>:4318"  (HTTP)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:{{ otlp_grpc_port }}"
  }
  http {
    endpoint = "0.0.0.0:{{ otlp_http_port }}"
  }

  output {
    // Forward only metrics — no Loki or Tempo configured yet
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// Convert OTel metric format to Prometheus and push to the existing remote_write
otelcol.exporter.prometheus "default" {
  forward_to                  = [prometheus.remote_write.platform.receiver]
  resource_to_telemetry_conversion = true
}

// ── Loki Scraping - logs ───────────────


// Scrape systemd journal
loki.source.journal "systemd" {
  max_age       = "24h"
  forward_to    = [loki.write.local.receiver]
  labels        = {
    job  = "systemd",
    host = "{{ ansible_hostname }}",
  }
}

// Discover Docker containers
discovery.docker "containers" {
  host = "{{ active_docker_socket }}"
}

// Filter out infrastructure containers
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Drop infra containers - we don't want Loki logging about itself
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(loki|alloy|grafana|prometheus|buildx.*)$"
    action        = "drop"
  }

  // Extract container name without leading slash
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  // Add log stream (stdout/stderr) as label
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

// Scrape Docker container logs (only non-infra containers)
loki.source.docker "containers" {
  host       = "{{ active_docker_socket }}"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.uvicorn.receiver]
  labels = {
    job  = "docker",
    host = "{{ ansible_hostname }}",
  }
}

// Parse log levels from application logs (e.g., uvicorn, Python apps)
loki.process "uvicorn" {
  forward_to = [loki.write.local.receiver]

  // Extract log level from common Python logging formats
  // Matches: "INFO:", "ERROR:", "WARNING:", "DEBUG:", "CRITICAL:"
  stage.regex {
    expression = "^(?P<level>INFO|WARNING|ERROR|CRITICAL|DEBUG):\\s+.*"
  }

  // Add log level as a label for filtering
  stage.labels {
    values = {
      level = "level",
    }
  }
}

// Scrape /var/log files
local.file_match "system_logs" {
  path_targets = [
    {
      __address__ = "localhost",
      __path__    = "/var/log/syslog",
      job         = "syslog",
      host        = "{{ ansible_hostname }}",
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/auth.log",
      job         = "auth",
      host        = "{{ ansible_hostname }}",
    },
  ]
}

loki.source.file "system_logs" {
  targets    = local.file_match.system_logs.targets
  forward_to = [loki.write.local.receiver]
}

// Send all logs to Loki
loki.write "local" {
  endpoint {
    url = "https://{{ loki.domain }}/loki/api/v1/push"
  }
}
