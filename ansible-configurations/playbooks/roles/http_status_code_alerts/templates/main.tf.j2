# ── Aggregate 5xx ─────────────────────────────────────────────────────────────
module "alert_high_5xx_rate" {
  source         = "../modules/threshold_alert"
  name           = "High5xxRate"
  folder_uid     = grafana_folder.http_alerts.uid
  datasource_uid = data.grafana_data_source.prometheus.uid
  expr           = "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\",service_name=\"${var.service_name}\"}[5m]))"
  threshold      = 0.05
  comparator     = "gt"
  for            = "2m"
  severity       = "critical"
  no_data_state  = "OK"
  service        = var.service_name
  summary        = "High 5xx rate on ${var.service_name}"
  description    = "Service is returning more than 0.05 server errors per second. Investigate immediately."
}

