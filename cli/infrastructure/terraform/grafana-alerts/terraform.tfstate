            "id": "1:bfmcewpj2dywwf:ContainerCPUThrottled",
            "interval_seconds": 60,
            "name": "ContainerCPUThrottled",
            "org_id": "1",
            "rule": [
              {
                "annotations": {
                  "description": "More than 25% of CPU time is being throttled.",
                  "summary": "Container {{ $labels.name }} CPU-throttled on vvasylkovskyi-F719T9V3V4"
                },
                "condition": "C",
                "data": [
                  {
                    "datasource_uid": "dfhl024ryyosgf",
                    "model": "{\"expr\":\"rate(container_cpu_cfs_throttled_seconds_total{name!=\\\"\\\",instance=\\\"vvasylkovskyi-F719T9V3V4\\\"}[5m]) / rate(container_cpu_usage_seconds_total{name!=\\\"\\\",instance=\\\"vvasylkovskyi-F719T9V3V4\\\"}[5m]) * 100\",\"refId\":\"A\"}",
                    "query_type": "",
                    "ref_id": "A",
