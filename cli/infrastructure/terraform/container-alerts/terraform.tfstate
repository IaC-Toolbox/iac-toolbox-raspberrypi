            "disable_provenance": false,
            "folder_uid": "dfmpz9r78bke8a",
            "id": "1:dfmpz9r78bke8a:ContainerCPUThrottled",
            "interval_seconds": 60,
            "name": "ContainerCPUThrottled",
            "org_id": "1",
            "rule": [
              {
                "annotations": {
                  "description": "More than 25% of CPU time is being throttled.",
                  "summary": "Container my-service CPU-throttled on vvasylkovskyi-F719T9V3V4"
                },
                "condition": "C",
                "data": [
                  {
                    "datasource_uid": "PBFA97CFB590B2093",
                    "model": "{\"expr\":\"rate(container_cpu_cfs_throttled_seconds_total{name=\\\"my-service\\\",instance=\\\"vvasylkovskyi-F719T9V3V4\\\"}[5m]) / rate(container_cpu_usage_seconds_total{name=\\\"my-service\\\",instance=\\\"vvasylkovskyi-F719T9V3V4\\\"}[5m]) * 100 and rate(container_cpu_usage_seconds_total{name=\\\"my-service\\\",instance=\\\"vvasylkovskyi-F719T9V3V4\\\"} [5m]) \\u003e 0\",\"refId\":\"A\"}",
                    "query_type": "",
                    "ref_id": "A",
                    "relative_time_range": [
                      {
                        "from": 600,
                        "to": 0
                      }
                    ]
                  },
                  {
                    "datasource_uid": "__expr__",
                    "model": "{\"expression\":\"A\",\"reducer\":\"last\",\"refId\":\"B\",\"type\":\"reduce\"}",
                    "query_type": "",
                    "ref_id": "B",
                    "relative_time_range": [
                      {
                        "from": 0,
                        "to": 0
                      }
                    ]
                  },
                  {
                    "datasource_uid": "__expr__",
                    "model": "{\"conditions\":[{\"evaluator\":{\"params\":[25],\"type\":\"gt\"},\"type\":\"query\"}],\"expression\":\"B\",\"refId\":\"C\",\"type\":\"threshold\"}",
                    "query_type": "",
                    "ref_id": "C",
                    "relative_time_range": [
                      {
                        "from": 0,
                        "to": 0
                      }
                    ]
                  }
