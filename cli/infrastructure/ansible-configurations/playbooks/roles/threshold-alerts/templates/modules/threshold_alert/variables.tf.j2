
variable "name"           { type = string }
variable "folder_uid"     { type = string }
variable "datasource_uid" { type = string }
variable "expr"           { type = string }
variable "threshold"      { type = number }

variable "comparator" {
  type    = string
  default = "gt"
}

variable "for" {
  type    = string
  default = "5m"
}

variable "severity" {
  type    = string
  default = "critical"
}

variable "summary"     { type = string }

variable "description" {
  type    = string
  default = ""
}

variable "no_data_state" {
  type    = string
  default = "NoData"
}

# node and service are optional — omit either to suppress that label on the alert.
# node:    set by the platform team for host-level alerts (known at render time)
# service: set by dev teams for container-level alerts (identifies the application)
variable "node" {
  type    = string
  default = ""
}

variable "service" {
  type    = string
  default = ""
}